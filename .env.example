# Valorant Matches Configuration
# Copy this file to .env and adjust values as needed

# Request settings
REQUEST_TIMEOUT=10
MAX_RETRIES=3
RETRY_DELAY=1
RATE_LIMIT_DELAY=0.5

# Cache settings
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Optional runtime path overrides (use absolute paths)
# VALORANT_MATCHES_HOME=/path/to/valorant-matches-data
# CACHE_DIR=/path/to/valorant-matches-cache

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
